# Variables de entorno de los workers (ut-llano-alianza-workers).
# Si no se ponen, se usan estos mismos valores.
CAMUNDA_URL=http://localhost:8080/engine-rest
REGISTROS_URL=http://localhost:8082/api

# En Windows (PowerShell), antes de npm start:
#   $env:CAMUNDA_URL="http://localhost:8080/engine-rest"
#   $env:REGISTROS_URL="http://localhost:8082/api"
# Con Node 20.6 o superior también se puede: node --env-file=workers.env.ejemplo index.js
